# Szablon lokalnych sekretów do `make test-live` (GH-265).
#
#   cp ksef.secrets.env.example ksef.secrets.env
#
# ksef.secrets.env jest ignorowany przez git — nigdy go nie commituj.
# Wartości pochodzą WYŁĄCZNIE ze środowiska testowego KSeF: NIP podmiotu,
# na którym masz dostęp w aplikacji testowej, i token wygenerowany tam
# z uprawnieniem InvoiceRead. Środowisko jest wpisane na sztywno w
# bin/ksef_live.py jako `test` — ten plik go nie wybiera.
#
# Zmienne środowiskowe o tych nazwach mają pierwszeństwo przed plikiem.
# `missing-secret` liczy się jako brak wartości.
KSEF_LIVE_TEST_NIP=missing-secret
KSEF_LIVE_TEST_TOKEN=missing-secret
